# Server-side configuration only. Copy to .env (never commit .env).
PORT=3000
# Comma-separated list of allowed web client origins
CORS_ORIGINS=http://localhost:5173
# OpenTelemetry: leave endpoint empty to export to the console
OTEL_SERVICE_NAME=micro-v5-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# AI provider credentials: supplied by the server environment, never committed
AI_PROVIDER_API_KEY=
# Outbound HTTP retry policy (exponential backoff with jitter)
HTTP_RETRY_MAX_ATTEMPTS=4
HTTP_RETRY_BASE_DELAY_MS=200
HTTP_RETRY_MAX_DELAY_MS=5000
# Elasticsearch search index (REST API). Index names are "<prefix>-<name>", lowercase.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=micro-v5
# Optional API key for secured clusters, supplied by the server environment
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000
